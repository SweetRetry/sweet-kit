    "@types/node": "^25.5.0",
    "@workspace/typescript-config": "workspace:*",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
