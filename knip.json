{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["peers"],
  "ignoreWorkspaces": ["packages/ui"],
  "ignore": ["scripts/**", "rules/**"],
  "workspaces": {
    "apps/web": {
      "entry": ["app/**/*.{ts,tsx}", "lib/**/*.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/server": {
      "entry": ["src/auth-config.ts"],
      "project": ["src/**/*.ts"],
      "drizzle": false
    },
    "apps/cli": {
      "project": ["src/**/*.ts"]
    },
    "apps/worker": {
      "project": ["src/**/*.ts"]
    },
    "packages/request": {
      "project": ["src/**/*.ts"]
    },
    "packages/logger": {
      "project": ["src/**/*.ts"]
    },
    "packages/observability": {
      "project": ["src/**/*.ts"]
    },
    "packages/tracing": {
      "project": ["src/**/*.ts"]
    },
    "packages/typescript-config": {
      "entry": [],
      "project": ["*.json"]
    }
  },
  "ignoreDependencies": ["@tailwindcss/postcss", "pino-pretty"],
  "ignoreUnresolved": ["next"]
}
