BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3000
SERVER_URL=http://localhost:3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
DATABASE_URL=postgresql://sweet:sweet@localhost:5432/sweet_kit
LOG_LEVEL=info
LOG_PRETTY=false
JOB_CONCURRENCY=5
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sweet-kit
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sweet
S3_SECRET_ACCESS_KEY=sweetsweet
# Production (Vercel): STORAGE_PROVIDER=vercel-blob
# Production (Vercel): BLOB_READ_WRITE_TOKEN=vercel_blob_...
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# Local override: OTEL_TRACES_EXPORTER=console
# Production: OTEL_TRACES_EXPORTER=otlp
# Production: OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Production: OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com
# Production: OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20replace-me
