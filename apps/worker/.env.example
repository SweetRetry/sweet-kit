# ─── Runtime ─────────────────────────────────────────────
NODE_ENV=development

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://sweet:sweet@localhost:5432/sweet_kit

# ─── Worker ──────────────────────────────────────────────
JOB_CONCURRENCY=5

# ─── Logger ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false

# ─── OpenTelemetry ───────────────────────────────────────
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
