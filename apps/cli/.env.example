# ─── URLs ────────────────────────────────────────────────
SWEET_KIT_SERVER_URL=http://localhost:43111

# ─── Trace 查询 ──────────────────────────────────────────
# `sweet trace` 默认同时读 apps/server/data/traces.jsonl 与 apps/worker/data/traces.jsonl；
# 设置后只读这一个文件（--file 可在命令行覆盖，且可重复）
# SWEET_KIT_TRACE_FILE=/path/to/traces.jsonl
