{
  "name": "cli",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "sweet": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sweet": "NODE_OPTIONS=--conditions=development DOTENV_CONFIG_PATH=.env.local tsx src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/observability": "workspace:*",
    "@workspace/request": "workspace:*",
    "better-auth": "^1.7.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "open": "^11.0.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@workspace/typescript-config": "workspace:*",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
