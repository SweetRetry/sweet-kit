# ─── Runtime ─────────────────────────────────────────────
NODE_ENV=development

# ─── URLs ────────────────────────────────────────────────
SERVER_URL=http://localhost:43111
WEB_URL=http://localhost:43110

# ─── Auth ────────────────────────────────────────────────
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://sweet:sweet@localhost:5432/sweet_kit

# ─── Server ──────────────────────────────────────────────
PORT=43111

# 仅在服务确实部署在可信代理之后时设为 true：启用后才读取 x-forwarded-for
TRUST_PROXY=false

# ─── AI provider ────────────────────────────────────────
# 未设置时 /api/assistant/reply 返回 503 SERVICE_UNAVAILABLE
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ─── Logger ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false

# ─── OpenTelemetry ───────────────────────────────────────
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com
